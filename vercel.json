{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/scrape-delmak-now?token=@admin_token",
      "schedule": "0 2 * * *"
    }
  ]
}
